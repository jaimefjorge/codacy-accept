{
  "name": "codacy-accept",
  "version": "0.1.0",
  "description": "Proof that your AI agent's code actually works",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "codacy-accept": "./bin/codacy-accept.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src/",
    "prepublishOnly": "npm run build",
    "postinstall": "echo '\\n  To use codacy-accept, install Playwright browsers:\\n    npx playwright install chromium\\n'"
  },
  "keywords": [
    "testing",
    "verification",
    "ai",
    "playwright",
    "screenshots"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "files": [
    "dist/",
    "bin/",
    "templates/",
    "skill/"
  ],
  "dependencies": {
    "@anthropic-ai/sdk": "^0.78.0",
    "@playwright/test": "^1.58.2",
    "chalk": "^5.6.2",
    "commander": "^14.0.3",
    "playwright": "^1.58.2",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@types/node": "^25.3.0",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "eslint": "^10.0.0",
    "typescript": "^5.9.3",
    "vitest": "^4.0.18"
  }
}
